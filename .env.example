# Copiá este archivo como ".env" y completá tus valores reales.
# NUNCA subas el archivo ".env" (con tus credenciales reales) a GitHub.

# Cadena de conexión de tu base de datos PostgreSQL (Neon, Supabase, Render, etc.)
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_basededatos

# Clave secreta para firmar los tokens de sesión (JWT). Generá una larga y aleatoria.
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# Access token de Mercado Pago (Panel de desarrolladores -> Tus integraciones -> Credenciales)
# Usá primero las credenciales de PRUEBA (test) hasta confirmar que todo funciona.
MP_ACCESS_TOKEN=TEST-000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000

# Token propio (inventalo vos) para poder llamar a las rutas de administración (verificar talleres)
ADMIN_TOKEN=elegi-un-token-secreto-para-vos-mismo

# URL pública donde queda publicado el FRONTEND (se usa para volver del pago de Mercado Pago)
FRONTEND_URL=http://localhost:3000

# URL pública donde queda publicado este mismo BACKEND (se usa para recibir el aviso de pago)
BACKEND_URL=http://localhost:3000

# Puerto en el que corre el servidor (Render/Railway lo define automáticamente en producción)
PORT=3000
